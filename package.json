{
  "name": "sw2026",
  "version": "1.0.0",
  "description": "E-commerce REST API with JWT authentication and checkout",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "mocha \"test/pathCoverage/**/*.test.js\" --timeout 10000 --exit --reporter mochawesome --reporter-options reportDir=mochawesome-report,reportFilename=path-coverage,overwrite=true,html=true,json=true"
